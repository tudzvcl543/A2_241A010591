<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/navy">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/subtitle" android:textColor="@color/mint"
            android:textSize="12sp" android:letterSpacing="0.15" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/title"
            android:textColor="@color/white" android:textStyle="bold" android:textSize="27sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="@string/student"
            android:textColor="@color/muted" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:padding="24dp" android:gravity="center"
            android:orientation="vertical" android:background="@drawable/bg_panel">
            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/status_paused"
                android:textColor="@color/orange" android:textSize="12sp"
                android:letterSpacing="0.12" android:textStyle="bold" />
            <TextView android:id="@+id/tvTime" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="@string/zero_time" android:fontFamily="monospace"
                android:textColor="@color/white" android:textSize="53sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/tvRecreate" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:textColor="@color/muted" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="horizontal">
            <Button android:id="@+id/btnStartPause" android:layout_width="0dp"
                android:layout_height="54dp" android:layout_weight="1"
                android:background="@drawable/bg_primary" android:text="@string/start"
                android:textAllCaps="false" android:textColor="@color/navy" />
            <Button android:id="@+id/btnLap" android:layout_width="0dp"
                android:layout_height="54dp" android:layout_marginStart="10dp"
                android:layout_weight="1" android:background="@drawable/bg_secondary"
                android:text="@string/lap" android:textAllCaps="false"
                android:textColor="@color/white" />
            <Button android:id="@+id/btnReset" android:layout_width="0dp"
                android:layout_height="54dp" android:layout_marginStart="10dp"
                android:layout_weight="1" android:background="@drawable/bg_secondary"
                android:text="@string/reset" android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>

        <CheckBox android:id="@+id/checkPauseOnBackground" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:text="@string/pause_in_background" android:textColor="@color/white" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="32dp" android:text="@string/hint_background"
            android:textColor="@color/muted" android:textSize="12sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="30dp" android:text="@string/lap_heading"
            android:textColor="@color/mint" android:textSize="12sp"
            android:letterSpacing="0.15" android:textStyle="bold" />
        <TextView android:id="@+id/tvLaps" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel" android:padding="20dp"
            android:text="@string/no_laps" android:textColor="@color/white"
            android:textSize="15sp" android:lineSpacingExtra="10dp" />
    </LinearLayout>
</ScrollView>
